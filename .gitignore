@'
# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
venv/
env/

# Logs and runtime artifacts
*.log
*.tmp
*.bak
*.old
reports/
output/
outputs/

# Environment and secrets
.env
.env.*
!.env.example

# Private keys and sensitive key material
*.pem
*.key
*.p12
*.pfx
*.jks
id_rsa
id_ed25519
*private*
*secret*

# Keep only explicit examples
!*.example
!*.example.*
!configs/examples/*

# Packet captures
# Public repo should keep only reviewed lab samples.
*.pcap
*.pcapng
!sample-data/**/*.pcap
!sample-data/**/*.pcapng

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/

# Archives
*.zip
*.7z
*.rar
*.tar
*.gz